    nodo_2_0 [label="{COL-30101\nLucia Flores\nDEP-MED | TIPO-03}", fillcolor="#A9DFBF"];
    bucket_2 -> nodo_2_0;
    null_2 [label="NULL", fillcolor="#FADBD8"];
